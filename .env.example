# ============================================================================
# Telegram Credentials
# - TELEGRAM_API_ID / TELEGRAM_API_HASH: https://my.telegram.org/apps
# - TELEGRAM_BOT_TOKEN: https://t.me/BotFather
# ============================================================================
TELEGRAM_API_ID=12345678
TELEGRAM_API_HASH=0123456789abcdef0123456789abcdef
TELEGRAM_BOT_TOKEN=123456789:AAExampleBotTokenStringHere

# ============================================================================
# Local Telegram Bot API Configuration
# ============================================================================
# Enable local Bot API server mode (bypasses 20MB limit up to 2000MB)
TELEGRAM_USE_LOCAL_API=true

# Base URL for the local telegram-bot-api server:
# - Use http://localhost:8081 when running the Python bot on the host/WSL via `uv`
# - Overridden to http://telegram-bot-api:8081 inside docker-compose for container-to-container networking
TELEGRAM_LOCAL_API_URL=http://localhost:8081

# Port exposed on the host for telegram-bot-api
TELEGRAM_LOCAL_API_PORT=8081

# Internal container working directory where telegram-bot-api writes files
TELEGRAM_LOCAL_API_WORK_DIR=/var/lib/telegram-bot-api

# Host path mapped to TELEGRAM_LOCAL_API_WORK_DIR (used in hybrid local uv + WSL Docker mode)
TELEGRAM_LOCAL_API_HOST_DIR=./storage/telegram-bot-api

# ============================================================================
# External Metadata, Fingerprinting & Lyrics Services
# - ACOUSTID_API_KEY: https://acoustid.org/new-application
# - MUSICBRAINZ_*: No API key required (identifies client per https://musicbrainz.org/doc/MusicBrainz_API/Rate_Limiting)
# - GENIUS_ACCESS_TOKEN: https://genius.com/api-clients (Client Access Token; public search fallback used if empty)
# - LASTFM_API_KEY / LASTFM_API_SECRET: https://www.last.fm/api/account/create
# - LRCLIB_BASE_URL: https://lrclib.net/docs (Free, no API key required)
# ============================================================================
ACOUSTID_API_KEY=your_acoustid_api_key_here
MUSICBRAINZ_APP_NAME=MusicIngestBot
MUSICBRAINZ_APP_VERSION=0.1.0
MUSICBRAINZ_CONTACT=admin@example.com
GENIUS_ACCESS_TOKEN=
LASTFM_API_KEY=
LASTFM_API_SECRET=
LRCLIB_BASE_URL=https://lrclib.net/api

# ============================================================================
# Storage, External Docker Mounts, Database & Pipeline Settings
# ============================================================================
# Optional YAML config file path (defaults to config.yaml if present)
CONFIG_FILE=config.yaml

# Pre-built Docker image published by GitHub Actions to GHCR (used by `docker compose pull`)
# Default: ghcr.io/wip-sama/musicinjestor:latest
MUSIC_BOT_IMAGE=ghcr.io/wip-sama/musicinjestor:latest

# Host path to your external music folder (mounted to /mnt/music/library inside Docker)
# Examples: /mnt/nas/music, /srv/media/music, D:/Music, or ./storage/library
HOST_MUSIC_DIR=./storage/library

# Local/container paths and file permissions
STORAGE_SCRATCH_DIR=./storage/scratch
STORAGE_LIBRARY_DIR=./storage/library
DATABASE_PATH=./storage/library.db
UMASK=0022
PUID=0
PGID=0
AUTO_APPROVE_CONFIDENCE=0.90
LOG_LEVEL=INFO

# System binary names/paths (override on Windows if not on PATH)
FPCALC_BINARY=fpcalc
SEVENZIP_BINARY=7z

# ============================================================================
# Governance, RBAC, Queue & Admin Log Channel
# ============================================================================
OWNER_TELEGRAM_IDS=10000001
ADMIN_LOG_CHANNEL_ID=-1001234567890
QUEUE_CONCURRENCY_LIMIT=1

# ----------------------------------------------------------------------------
# SECRET_KEY Configuration Guide:
# ----------------------------------------------------------------------------
# Purpose & Roles:
# 1. OIDC State Nonces: Generates HMAC-SHA256 signatures for CSRF prevention in
#    OAuth2 authorization flows (10-minute TTL).
# 2. Token Encryption: Symmetrically encrypts stored OAuth2 access & refresh tokens
#    in SQLite WAL persistence using authenticated HMAC keystream encryption.
# 3. Web App Login & Sessions: Cryptographically signs and validates session HMACs
#    for the Telegram Mini App API (/api/v1/app/...).
#
# How to generate a secure random 32-byte secret key:
# - Linux/macOS/WSL:  openssl rand -hex 32
# - Python CLI:       python -c "import secrets; print(secrets.token_hex(32))"
# - PowerShell:       [Convert]::ToHexString((1..32 | ForEach-Object { Get-Random -Maximum 256 } | ForEach-Object { [byte]$_ }))
# ----------------------------------------------------------------------------
SECRET_KEY=replace-with-secure-random-32-byte-secret-key
NODE_NAME=Proxmox LXC 104

# ============================================================================
# Authentik OIDC Federation (SSO) & Automatic Role Mapping
# ============================================================================
# ----------------------------------------------------------------------------
# Authentik / Keycloak Setup Guide:
# ----------------------------------------------------------------------------
# 1. Create OAuth2/OpenID Provider in Authentik:
#    - Navigate to: Applications › Providers › Create
#    - Type: OAuth2/OpenID Provider
#    - Name: Music Ingest Bot Provider
#    - Client type: Confidential
#    - Redirect URIs: http://localhost:8080/api/v1/auth/callback
#      (or your public HTTPS domain: https://music.example.com/api/v1/auth/callback)
#    - Signing Key: Select your Authentik Certificate-Key Pair
#    - Scopes: Select 'openid', 'profile', 'email', and 'authentik default OAuth Mapping: OpenID 'groups''
#
# 2. Create Application in Authentik:
#    - Navigate to: Applications › Applications › Create
#    - Name: Music Ingest Bot
#    - Slug: music-ingest-bot
#    - Provider: Select 'Music Ingest Bot Provider'
#
# 3. Automatic Role Mapping (OIDC_ROLE_MAPPING):
#    - When users log in via Authentik SSO, their group claims are inspected and mapped
#      to bot RBAC roles: GUEST (0), LISTENER (1), UPLOADER (2), MODERATOR (3), ADMIN (4).
#    - If a user belongs to multiple groups, the bot grants the HIGHEST matching role.
#    - You can specify role mapping as a JSON dictionary or comma-separated pairs:
#        OIDC_ROLE_MAPPING={"authentik Admins": "ADMIN", "music-uploaders": "UPLOADER", "family": "UPLOADER", "listeners": "LISTENER"}
#        OIDC_ROLE_MAPPING=authentik Admins=ADMIN,music-uploaders=UPLOADER,family=UPLOADER,listeners=LISTENER
#    - Default mapping (if left empty):
#        music-admins -> ADMIN
#        music-moderators -> MODERATOR
#        music-uploaders -> UPLOADER
#        music-listeners, music-viewers -> LISTENER
#        (Unmatched groups default to GUEST)
#
# 4. Local Role Overrides:
#    - When an administrator modifies a user's role in Telegram (/admin › Users › Detail)
#      or the Mini App, or taps [ 🔒 Lock Role (Override OIDC) ], local role override is activated.
#    - When override is active, background OIDC synchronizations (every 15 min or 1 hr)
#      will NOT overwrite the administrator's assigned role.
#    - Admins can unlock role synchronization at any time with [ 🔓 Unlock Role (Sync OIDC) ].
#
# 5. Disconnecting OIDC Accounts:
#    - Users can unlink their own account at any time via /auth › [ ❌ Disconnect SSO ]
#      or /settings › [ ❌ Disconnect Authentik SSO ].
#    - Administrators can unlink any user's OIDC link via /admin › Users › Detail › [ ❌ Disconnect OIDC ]
#      or via the REST API (POST /api/v1/app/admin/users/:user_id/oidc/disconnect).
# ----------------------------------------------------------------------------
OIDC_ENABLED=false
OIDC_AUTHORIZE_URL=https://auth.example.com/application/o/authorize
OIDC_TOKEN_URL=https://auth.example.com/application/o/token
OIDC_USERINFO_URL=https://auth.example.com/application/o/userinfo
OIDC_CLIENT_ID=music-ingest-bot
OIDC_CLIENT_SECRET=your_authentik_client_secret_here
OIDC_REDIRECT_URI=http://localhost:8080/api/v1/auth/callback
OIDC_WEBHOOK_SECRET=your_authentik_webhook_secret_here
OIDC_LISTEN_HOST=0.0.0.0
OIDC_LISTEN_PORT=8080
OIDC_SYNC_INTERVAL_SECONDS=3600

# Optional custom OIDC role mapping (JSON format or comma-separated key=value pairs)
# Examples:
# OIDC_ROLE_MAPPING={"authentik Admins": "ADMIN", "music-uploaders": "UPLOADER", "family": "UPLOADER", "listeners": "LISTENER"}
# OIDC_ROLE_MAPPING=authentik Admins=ADMIN,music-uploaders=UPLOADER,family=UPLOADER,listeners=LISTENER
OIDC_ROLE_MAPPING=

# ============================================================================
# Telegram Mini App (TMA) & Unified Web Server Configuration
# ============================================================================
# Enable the built-in HTTP server for the Telegram Mini App (serves API + static SPA)
WEB_APP_ENABLED=true

# Public HTTPS URL where your Mini App is accessible by Telegram clients
# Examples: https://music.example.com, Cloudflare Tunnel, or ngrok URL
# Note: Telegram WebViews strictly require HTTPS with valid SSL/TLS certificates.
# When configured, the bot sets the persistent bottom-left chat Menu Button to launch the Web App.
WEB_APP_URL=

# Directory containing built SPA frontend assets (from `npm run build` in webapp/)
WEB_APP_STATIC_DIR=./webapp/dist

# Unified HTTP listener bind host and port
WEB_LISTEN_HOST=0.0.0.0
WEB_LISTEN_PORT=8080

