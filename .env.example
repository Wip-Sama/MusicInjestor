# ============================================================================
# Telegram Credentials
# Obtain API_ID and API_HASH from https://my.telegram.org
# Obtain BOT_TOKEN from @BotFather on Telegram
# ============================================================================
TELEGRAM_API_ID=12345678
TELEGRAM_API_HASH=0123456789abcdef0123456789abcdef
TELEGRAM_BOT_TOKEN=123456789:AAExampleBotTokenStringHere

# ============================================================================
# Local Telegram Bot API Configuration
# ============================================================================
# Enable local Bot API server mode (bypasses 20MB limit up to 2000MB)
TELEGRAM_USE_LOCAL_API=true

# Base URL for the local telegram-bot-api server:
# - Use http://localhost:8081 when running the Python bot on the host/WSL via `uv`
# - Overridden to http://telegram-bot-api:8081 inside docker-compose for container-to-container networking
TELEGRAM_LOCAL_API_URL=http://localhost:8081

# Port exposed on the host for telegram-bot-api
TELEGRAM_LOCAL_API_PORT=8081

# Internal container working directory where telegram-bot-api writes files
TELEGRAM_LOCAL_API_WORK_DIR=/var/lib/telegram-bot-api

# Host path mapped to TELEGRAM_LOCAL_API_WORK_DIR (used in hybrid local uv + WSL Docker mode)
TELEGRAM_LOCAL_API_HOST_DIR=./storage/telegram-bot-api

# ============================================================================
# External Metadata & Fingerprinting Services
# ============================================================================
ACOUSTID_API_KEY=your_acoustid_api_key_here
MUSICBRAINZ_APP_NAME=MusicIngestBot
MUSICBRAINZ_APP_VERSION=0.1.0
MUSICBRAINZ_CONTACT=admin@example.com
LRCLIB_BASE_URL=https://lrclib.net/api

# ============================================================================
# Storage, Database & Pipeline Settings
# ============================================================================
STORAGE_SCRATCH_DIR=./storage/scratch
STORAGE_LIBRARY_DIR=./storage/library
DATABASE_PATH=./storage/library.db
AUTO_APPROVE_CONFIDENCE=0.90
LOG_LEVEL=INFO

# System binary names/paths (override on Windows if not on PATH)
FPCALC_BINARY=fpcalc
SEVENZIP_BINARY=7z

