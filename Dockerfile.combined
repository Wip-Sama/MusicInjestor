# Combined single-container image bundling the Music Ingestion Bot, WebApp, and Music Provider.
# Note: Intentionally excluded from GitHub Actions CI/CD; build locally with:
#   docker build -f Dockerfile.combined -t music-ingest-combined .

# Stage 1: Build the React / Vite Telegram Mini App frontend
FROM node:22-bookworm-slim AS webapp-builder

WORKDIR /app/webapp

COPY webapp/package.json webapp/package-lock.json ./
RUN npm ci

COPY webapp/ ./
RUN npm run build

# Stage 2: Combined Python runtime for Bot + Provider
FROM ghcr.io/astral-sh/uv:python3.14-bookworm-slim

RUN apt-get update && apt-get install -y --no-install-recommends \
    libchromaprint-tools \
    7zip \
    ffmpeg \
    ca-certificates \
    curl \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

ENV UV_COMPILE_BYTECODE=1 \
    UV_LINK_MODE=copy \
    PYTHONUNBUFFERED=1 \
    PYTHONPATH=/app:/app/provider/src \
    PATH="/app/.venv/bin:${PATH}" \
    WEB_APP_DEV_MODE=false \
    WEB_APP_STATIC_DIR=/app/webapp/dist \
    PROVIDER_HOST=0.0.0.0 \
    PROVIDER_PORT=8085 \
    PROVIDER_STORAGE_DIR=/data/artifacts \
    PROVIDER_DEFAULT_ENGINE=composite \
    PROVIDER_BOT_TOKEN="" \
    DEFAULT_MUSIC_PROVIDER_URL=http://127.0.0.1:8085

# Install production dependencies for both root bot and provider workspace package
COPY pyproject.toml uv.lock .python-version ./
COPY provider/pyproject.toml provider/README.md ./provider/
RUN uv sync --frozen --no-dev --all-packages --no-install-project

# Copy built static frontend assets from webapp-builder stage
COPY --from=webapp-builder /app/webapp/dist /app/webapp/dist

# Copy application & provider runtime sources (no tests/ or .github/)
COPY src/ ./src/
COPY provider/src/ ./provider/src/
COPY scripts/run_combined.py ./scripts/run_combined.py
COPY main.py README.md .env.example config.example.yaml ./

# Ensure runtime storage and external music mount directories exist inside the container
RUN mkdir -p /app/storage/scratch /app/storage/library /app/storage/cache/streams /var/lib/telegram-bot-api /mnt/music/library /data/artifacts \
    && chmod 777 /data/artifacts

EXPOSE 8080 8085

HEALTHCHECK --interval=30s --timeout=5s --start-period=15s --retries=3 \
    CMD curl -f http://127.0.0.1:8085/api/v1/health || exit 1

CMD ["python", "scripts/run_combined.py"]
